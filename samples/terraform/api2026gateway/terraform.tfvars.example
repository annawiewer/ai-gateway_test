# Preparation only: these placeholders do not authorize a live deployment.
# Use a NEW terraform.tfvars and separate backend/state in this directory.
# Never copy legacy/customer state or load the parent's 01-04 private profiles.
subscription_id  = "00000000-0000-0000-0000-000000000000"
environment_name = "api2026gateway"
location         = "<approved-foundry-region>"
gateway_location = "<approved-gateway-region>"

# The three model deployments and two aliases default to model-profile.json.
# Check all pinned model versions, GlobalStandard quota and data residency first.
# Defaults include token limits, monthly cost amount 10 and 100 requests/minute.
# Each deployment explicitly binds the Microsoft.DefaultV2 backend safety policy.
# Optional: examples\model-routing.tfvars.example illustrates complete paired-map overrides.
# It is not automatically loaded. Omitted entries do not survive a map replacement.

# Optional model-call IP allow list. Empty leaves IP filtering off.
# Replace these documentation ranges with approved client/proxy egress ranges
# before enabling. They do not configure private ingress or management access
# and do not apply to MCP tool servers.
# model_allowed_client_cidrs = ["203.0.113.42/32", "2001:db8:1234::/48"]

# Optional gateway-wide allow list for models AND MCP tool servers. Leave it unset
# (null) to keep gateway policies unmanaged. Callers outside it, including CI and
# hosted agents, get 403; portal and ARM management are unaffected. To remove it,
# apply [] and then unset it. Replace these documentation ranges with approved
# egress ranges first.
# gateway_allowed_client_cidrs = ["203.0.113.42/32", "2001:db8:1234::/48"]

# Optional MCP tool servers. The default registers the public Microsoft Learn
# MCP server; {} registers none. A supplied map replaces the whole default.
# Registration does not prove that the remote server is reachable.
# mcp_tool_servers = {}

# Outbound integration only, configured before creating the gateway:
# gateway_backend_subnet_id = "/subscriptions/<id>/resourceGroups/<platform-rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<delegated-subnet>"
# The existing subnet must use Microsoft.App/environments delegation.
# The sample never creates or updates the subnet, NSG, routes or central DNS.

# Optional caller access uses Entra OBJECT IDs, not application/client IDs.
# API-key authentication remains available; this is not an Entra-only switch.
# gateway_access_principals = {
#   application = {
#     principal_id   = "<managed-identity-or-service-principal-object-id>"
#     principal_type = "ServicePrincipal"
#   }
# }

# Optional: reuse one existing resource group. Fresh state only, chosen before
# the first apply; Terraform reads the group but never creates or deletes it.
# Never toggle this on an existing state; stop if a plan destroys a group.
# api2026_resource_group_name     = "<existing-resource-group>"
# api2026_existing_resource_group = true
