            "borderStyle": "solid",
            "borderWidth": "1px",
            "fontWeight": "bold",
            "rangeBehavior": 1
          }
        ]
      }
    }
  },
  "extensions": {
    "recommendations": [
      "fabiospampinato.vscode-highlight"
    ]
  }
}
